# Groq (default provider): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (OCR of scanned pages; optional): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Spending cap for the paid provider, in USD (persistent ledger in .cache/gemini_spend.json)
AMBER_GEMINI_BUDGET_USD=1.50
# Optional: AMBER_PROVIDER=groq|gemini|ollama   AMBER_GROQ_MODEL=openai/gpt-oss-120b   AMBER_OCR=cached|off|gemini|groq|ollama (default cached: reuse earlier scan text, never call a model)
# Free hosts of the same model, used automatically (in this order) when Groq is out of capacity. Optional.
# OpenRouter: https://openrouter.ai/keys  (free variant openai/gpt-oss-120b:free; about 50 requests a day)
OPENROUTER_API_KEY=
# Cerebras: https://cloud.cerebras.ai  (free-trial credit; model gpt-oss-120b)
CEREBRAS_API_KEY=
# NVIDIA: https://build.nvidia.com/openai/gpt-oss-120b  ("Get API Key"; free trial; model openai/gpt-oss-120b)
NVIDIA_API_KEY=
# Hugging Face: https://huggingface.co/settings/tokens  (fine-grained token with "Make calls to Inference Providers"; free monthly credits)
HF_TOKEN=
