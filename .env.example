# Groq (default provider): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (OCR of scanned pages; optional): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Spending cap for the paid provider, in USD (persistent ledger in .cache/gemini_spend.json)
AMBER_GEMINI_BUDGET_USD=1.50
# Optional: AMBER_PROVIDER=groq|gemini|ollama   AMBER_GROQ_MODEL=openai/gpt-oss-120b   AMBER_OCR=off
